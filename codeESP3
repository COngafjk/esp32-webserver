#include <Arduino.h>
#include <WiFi.h>
#include <HTTPClient.h>
#include <DHT.h>
#include <ArduinoJson.h> // Cài đặt thư viện ArduinoJson của Benoit Blanchon

const char* ssid = "404";
const char* password = "D889696@";
const char* serverUpdate = "http://192.168.44.23:3000/update"; 
const char* serverGetConfig = "http://192.168.44.23:3000/get-config";

#define DHT_PIN 4 
#define DHT_TYPE DHT11
#define MQ135_PIN 34
#define LED_PIN 19
#define BUZZER_PIN 18

DHT dht(DHT_PIN, DHT_TYPE);
float tempThreshold = 35.0; // Ngưỡng mặc định
int gasThreshold = 2000;    // Ngưỡng mặc định
unsigned long prevMillis = 0;

void setup() {
  Serial.begin(9600);
  dht.begin();
  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  
  WiFi.begin(ssid, password);
  while(WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
  Serial.println("\nWiFi Connected!");
}

void loop() {
  if (millis() - prevMillis >= 3000) {
    prevMillis = millis();

    float t = dht.readTemperature();
    float h = dht.readHumidity();
    int gas = analogRead(MQ135_PIN);

    // 1. Hiển thị đồng thời lên Serial
    Serial.println("--- THÔNG SỐ ĐO ĐƯỢC ---");
    Serial.printf("Nhiệt độ: %.2f °C | Độ ẩm: %.2f %% | Khí Gas: %d\n", t, h, gas);
    Serial.printf("Ngưỡng cài đặt: Temp > %.1f, Gas > %d\n", tempThreshold, gasThreshold);

    bool isAlert = (t > tempThreshold || gas > gasThreshold);

    // 2. Xử lý nhấp nháy LED và Còi
    if (isAlert) {
      Serial.println("!!! CẢNH BÁO ĐANG KÍCH HOẠT !!!");
      for(int i=0; i<3; i++) { // Nhấp nháy 3 lần
        digitalWrite(LED_PIN, HIGH); digitalWrite(BUZZER_PIN, HIGH);
        delay(100);
        digitalWrite(LED_PIN, LOW); digitalWrite(BUZZER_PIN, LOW);
        delay(100);
      }
    }

    if(WiFi.status() == WL_CONNECTED) {
      // GỬI DỮ LIỆU LÊN SERVER
      HTTPClient http;
      http.begin(serverUpdate);
      http.addHeader("Content-Type", "application/json");
      String jsonPayload = "{\"nhiet_do\":" + String(t) + ",\"do_am\":" + String(h) + 
                           ",\"khi_gas\":" + String(gas) + ",\"canh_bao\":" + (isAlert ? "true" : "false") + "}";
      http.POST(jsonPayload);
      http.end();

      // LẤY NGƯỠNG CÀI ĐẶT TỪ SERVER VỀ
      http.begin(serverGetConfig);
      int httpCode = http.GET();
      if (httpCode == 200) {
        String payload = http.getString();
        DynamicJsonDocument doc(256);
        deserializeJson(doc, payload);
        tempThreshold = doc["tempThreshold"];
        gasThreshold = doc["gasThreshold"];
      }
      http.end();
    }
    Serial.println("------------------------\n");
  }
}
